@page "/"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@using LoanManagementSystem.Models
@using LoanManagementSystem.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IDashboardRepository DashboardRepository
@inject AuthenticationStateProvider AuthenticationStateProvider

<h1 class="mb-4">🏦 Loan Management Dashboard</h1>

@if (dashboard == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>

        <p class="mt-3">
            Loading Dashboard...
        </p>
    </div>
}
else
{
    <!-- Summary Cards -->

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-lg h-100 bg-primary text-white">
                <div class="card-body">
                    <h6>Total Customers</h6>
                    <h3>@dashboard.UserCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-lg h-100 bg-success text-white">
                <div class="card-body">
                    <h6>Loan Applications</h6>
                    <h3>@dashboard.OrderCount</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-lg h-100 bg-warning text-dark">
                <div class="card-body">
                    <h6>Total Loan Amount</h6>
                    <h4>@dashboard.Revenue.ToString("C")</h4>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-lg h-100 bg-info text-white">
                <div class="card-body">
                    <h6>Expected Interest</h6>
                    <h4>@dashboard.Profit.ToString("C")</h4>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Loan Applications -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-dark text-white">
            Recent Loan Applications
        </div>

        <table class="table table-hover table-bordered mb-0">

            <thead>
                <tr>
                    <th>Application ID</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Loan Amount</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var application in dashboard.LatestOrders)
                {
                    <tr>
                        <td>@application.LoanApplicationId</td>
                        <td>@application.Name</td>
                        <td>@application.ApplicationStatus</td>
                        <td>@application.LoanAmount.ToString("C")</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Most Applied Loan Schemes -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">
            Most Applied Loan Schemes
        </div>

        <table class="table table-hover table-bordered mb-0">

            <thead>
                <tr>
                    <th>Loan Scheme</th>
                    <th>Applications</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var scheme in dashboard.TopSellingProducts)
                {
                    <tr>
                        <td>@scheme.ProductName</td>
                        <td>@scheme.Quantity</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- Recently Added Loan Schemes -->

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            Recently Added Loan Schemes
        </div>

        <table class="table table-hover table-bordered mb-0">

            <thead>
                <tr>
                    <th>Scheme Name</th>
                    <th>Interest Rate (%)</th>
                    <th>Maximum Loan Amount</th>
                    <th>Created Date</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var scheme in dashboard.RecentProducts)
                {
                    <tr>
                        <td>@scheme.SchemeName</td>
                        <td>@scheme.InterestRate.ToString("N2") %</td>
                        <td>@scheme.MaximumLoanAmount.ToString("C")</td>
                        <td>@scheme.CreatedDate.ToShortDateString()</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code
{
    private DashboardData? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await DashboardRepository.GetDashboardData();
    }
}