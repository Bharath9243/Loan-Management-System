@page "/loantypes"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using LoanManagementSystem.Models
@using LoanManagementSystem.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject ILoanTypeRepository LoanTypeRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Loan Types</h2>

    @if (isAdmin)
    {
        <button class="btn btn-primary"
                @onclick='() => NavigationManager.NavigateTo("/loantypes/create")'>
            Add Loan Type
        </button>
    }

</div>

@if (loanTypes == null)
{
    <div class="alert alert-info">
        Loading...
    </div>
}
else if (!loanTypes.Any())
{
    <div class="alert alert-warning">
        No Loan Types Found
    </div>
}
else
{
    <table class="table table-striped table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Loan Type</th>
                <th>Description</th>
                <th>Created Date</th>

                @if (isAdmin)
                {
                    <th>Edit</th>
                    <th>Delete</th>
                }
            </tr>
        </thead>

        <tbody>

            @foreach (var loanType in loanTypes)
            {
                <tr>

                    <td>@loanType.LoanTypeId</td>

                    <td>@loanType.LoanTypeName</td>

                    <td>@loanType.Description</td>

                    <td>@loanType.CreatedDate.ToShortDateString()</td>

                    @if (isAdmin)
                    {
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick='() => NavigationManager.NavigateTo($"/loantypes/edit/{loanType.LoanTypeId}")'>
                                Edit
                            </button>
                        </td>

                        <td>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteLoanType(loanType.LoanTypeId)">
                                Delete
                            </button>
                        </td>
                    }

                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<LoanType>? loanTypes;

    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        isAdmin = authState.User.IsInRole("Admin");

        loanTypes = await LoanTypeRepository.GetAllLoanTypes();
    }

    private async Task DeleteLoanType(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this Loan Type?");

        if (!confirmed)
            return;

        await LoanTypeRepository.DeleteLoanType(id);

        loanTypes = await LoanTypeRepository.GetAllLoanTypes();
    }

}