@page "/loanschemes"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using LoanManagementSystem.Models
@using LoanManagementSystem.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject ILoanSchemeRepository LoanSchemeRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Loan Schemes</h2>

    @if (isAdmin)
    {
        <button class="btn btn-primary"
                @onclick='() => NavigationManager.NavigateTo("/loanschemes/create")'>
            Add Loan Scheme
        </button>
    }

</div>

@if (loanSchemes == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Scheme Name</th>
                <th>Description</th>

                @if (isAdmin)
                {
                    <th>Processing Fee</th>
                }

                <th>Interest Rate (%)</th>
                <th>Maximum Loan Amount</th>
                <th>Loan Type</th>

                @if (isAdmin)
                {
                    <th>Edit</th>
                    <th>Delete</th>
                }

            </tr>

        </thead>

        <tbody>

            @foreach (var scheme in loanSchemes)
            {
                <tr>

                    <td>@scheme.LoanSchemeId</td>

                    <td>@scheme.SchemeName</td>

                    <td>@scheme.Description</td>

                    @if (isAdmin)
                    {
                        <td>₹ @scheme.ProcessingFee.ToString("N2")</td>
                    }

                    <td>@scheme.InterestRate.ToString("N2") %</td>

                    <td>₹ @scheme.MaximumLoanAmount.ToString("N2")</td>

                    <td>@scheme.LoanTypeName</td>

                    @if (isAdmin)
                    {
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick='() => NavigationManager.NavigateTo($"/loanschemes/edit/{scheme.LoanSchemeId}")'>
                                Edit
                            </button>
                        </td>

                        <td>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteLoanScheme(scheme.LoanSchemeId)">
                                Delete
                            </button>
                        </td>
                    }

                </tr>
            }

        </tbody>

    </table>
}

@code {

    private List<LoanScheme>? loanSchemes;

    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        isAdmin = authState.User.IsInRole("Admin");

        loanSchemes = await LoanSchemeRepository.GetAllLoanSchemes();
    }

    private async Task DeleteLoanScheme(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this Loan Scheme?"
        );

        if (!confirm)
            return;

        await LoanSchemeRepository.DeleteLoanScheme(id);

        loanSchemes = await LoanSchemeRepository.GetAllLoanSchemes();
    }

}