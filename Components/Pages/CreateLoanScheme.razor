@page "/loanschemes/create"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using LoanManagementSystem.Models
@using LoanManagementSystem.Interfaces
@using Microsoft.AspNetCore.Components.Forms

@inject ILoanSchemeRepository LoanSchemeRepository
@inject ILoanTypeRepository LoanTypeRepository
@inject NavigationManager NavigationManager

<h2 class="mb-4">Add Loan Scheme</h2>

<EditForm Model="@loanScheme" OnValidSubmit="SaveLoanScheme">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Scheme Name</label>

        <InputText class="form-control"
                   @bind-Value="loanScheme.SchemeName" />

        <ValidationMessage For="@(() => loanScheme.SchemeName)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>

        <InputText class="form-control"
                   @bind-Value="loanScheme.Description" />

        <ValidationMessage For="@(() => loanScheme.Description)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Processing Fee</label>

        <InputNumber class="form-control"
                     @bind-Value="loanScheme.ProcessingFee" />

        <ValidationMessage For="@(() => loanScheme.ProcessingFee)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Interest Rate (%)</label>

        <InputNumber class="form-control"
                     @bind-Value="loanScheme.InterestRate" />

        <ValidationMessage For="@(() => loanScheme.InterestRate)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Maximum Loan Amount</label>

        <InputNumber class="form-control"
                     @bind-Value="loanScheme.MaximumLoanAmount" />

        <ValidationMessage For="@(() => loanScheme.MaximumLoanAmount)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Loan Type</label>

        <InputSelect class="form-select"
                     @bind-Value="loanScheme.LoanTypeId">

            <option value="0">Select Loan Type</option>

            @if (loanTypes != null)
            {
                @foreach (var loanType in loanTypes)
                {
                    <option value="@loanType.LoanTypeId">
                        @loanType.LoanTypeName
                    </option>
                }
            }

        </InputSelect>

        <ValidationMessage For="@(() => loanScheme.LoanTypeId)" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Save Loan Scheme
    </button>

    <button type="button"
            class="btn btn-secondary ms-2"
            @onclick="Cancel">
        Cancel
    </button>

</EditForm>

@code
{
    private LoanScheme loanScheme = new();

    private List<LoanType>? loanTypes;

    protected override async Task OnInitializedAsync()
    {
        loanTypes = await LoanTypeRepository.GetAllLoanTypes();
    }

    private async Task SaveLoanScheme()
    {
        loanScheme.CreatedDate = DateTime.Now;

        await LoanSchemeRepository.CreateLoanScheme(loanScheme);

        NavigationManager.NavigateTo("/loanschemes");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/loanschemes");
    }
}