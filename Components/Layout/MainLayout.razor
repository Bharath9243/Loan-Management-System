@inherits LayoutComponentBase

@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container-fluid">

            @if (isAdmin)
            {
                <a class="navbar-brand fw-bold" href="/">
                    Loan Management System
                </a>
            }
            else
            {
                <span class="navbar-brand fw-bold">
                    Loan Management System
                </span>
            }

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <AuthorizeView Roles="Admin">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Dashboard</a>
                        </li>
                    </AuthorizeView>

                    <AuthorizeView Roles="Admin">
                        <li class="nav-item">
                            <a class="nav-link" href="/users">Customers</a>
                        </li>
                    </AuthorizeView>

                    <li class="nav-item">
                        <a class="nav-link" href="/loantypes">Loan Types</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/loanschemes">Loan Schemes</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/loanapplications">Applications</a>
                    </li>

                </ul>

                @if (isLoggedIn)
                {
                    <div class="d-flex align-items-center">

                        <span class="text-white me-3">
                            👤 @userName
                        </span>

                        <form method="post" action="/account/logout">
                            <button class="btn btn-outline-light" type="submit">
                                Logout
                            </button>
                        </form>

                    </div>
                }
                else
                {
                    <a href="/login" class="btn btn-outline-light">
                        Login
                    </a>
                }

            </div>

        </div>
    </nav>

    <!-- Page Content -->
    <main class="container mt-4 flex-grow-1">
        @Body
    </main>

</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private string userName = "";
    private bool isLoggedIn = false;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        isLoggedIn = authState.User.Identity?.IsAuthenticated ?? false;

        isAdmin = authState.User.IsInRole("Admin");

        if (isLoggedIn)
        {
            userName = authState.User.Identity!.Name!;
        }
    }
}